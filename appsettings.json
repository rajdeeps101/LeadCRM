{
  "AgentRuntime": {
    "Provider": "local-rules",
    "PdfValidation": {
      "MaxPages": 10,
      "GoogleGemini": {
        "Model": "gemini-3.6-flash"
      }
    },
    "Workflows": [
      {
        "Task": "lead-assessment",
        "Description": "Assess lead profile completeness and summarize document statuses.",
        "Agents": [
          "lead-readiness",
          "document-review-assistant"
        ]
      },
      {
        "Task": "document-review",
        "Description": "Summarize document metadata and current review states.",
        "Agents": [
          "document-review-assistant"
        ]
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
